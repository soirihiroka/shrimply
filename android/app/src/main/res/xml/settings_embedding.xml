<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:window="http://schemas.android.com/apk/res-auto">
    <SplitPairRule
        window:splitRatio="0.36"
        window:splitMinWidthDp="780"
        window:splitMinHeightDp="0"
        window:splitMinSmallestWidthDp="0"
        window:splitMaxAspectRatioInPortrait="alwaysAllow"
        window:finishPrimaryWithSecondary="never"
        window:finishSecondaryWithPrimary="always"
        window:clearTop="true">
        <SplitPairFilter
            window:primaryActivityName=".SettingsActivity"
            window:secondaryActivityName=".SettingsDetailActivity" />
    </SplitPairRule>
    <SplitPlaceholderRule
        window:placeholderActivityName=".SettingsDetailActivity"
        window:splitRatio="0.36"
        window:splitMinWidthDp="780"
        window:splitMinHeightDp="0"
        window:splitMinSmallestWidthDp="0"
        window:splitMaxAspectRatioInPortrait="alwaysAllow"
        window:finishPrimaryWithPlaceholder="adjacent">
        <ActivityFilter window:activityName=".SettingsActivity" />
    </SplitPlaceholderRule>
</resources>
