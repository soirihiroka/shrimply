[Desktop Entry]
Type=Application
Name=Shrimply Qt
GenericName=Video Editor
Comment=A simple video editor
Exec=/usr/libexec/shrimply/qt/shrimply %f
TryExec=/usr/libexec/shrimply/qt/shrimply
Icon=dev.shrimply.Shrimply
Terminal=false
StartupNotify=true
PrefersNonDefaultGPU=true
Categories=AudioVideo;Video;Qt;KDE;
MimeType=application/x-shrimply-project;
Keywords=video;audio;editor;timeline;
