{
  "name": "shrimply-windows-runtime",
  "version-string": "0.1.0",
  "builtin-baseline": "e93e1f6ab41a22fe711b1045dbbac5cbc9db60af",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avdevice",
        "avfilter",
        "avformat",
        "ffmpeg",
        "mp3lame",
        "nvcodec",
        "opus",
        "swresample",
        "swscale",
        "vorbis",
        "x264",
        "x265"
      ]
    },
    "pango",
    {
      "name": "poppler",
      "default-features": false,
      "features": ["cairo", "glib", "zlib"]
    }
  ]
}
