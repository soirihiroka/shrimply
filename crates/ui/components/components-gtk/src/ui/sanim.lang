<?xml version="1.0" encoding="UTF-8"?>
<language id="sanim" name="Sanim" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-sanim</property>
    <property name="globs">*.sanim</property>
    <property name="line-comment-start">#</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="function" name="Function" map-to="def:function"/>
    <style id="variable" name="Variable" map-to="def:identifier"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="boolean" name="Boolean" map-to="def:boolean"/>
  </styles>

  <definitions>
    <context id="line-comment" style-ref="comment" end-at-line-end="true">
      <start>#</start>
    </context>

    <context id="multiline-string" style-ref="string">
      <start>"""|'''</start>
      <end>\%{0@start}</end>
      <include><context ref="escape"/></include>
    </context>

    <context id="string" style-ref="string" end-at-line-end="true">
      <start>"|'</start>
      <end>\%{0@start}</end>
      <include><context ref="escape"/></include>
    </context>

    <context id="escape" style-ref="def:special-char">
      <match>\\.</match>
    </context>

    <context id="number" style-ref="number">
      <match extended="true">
        (?&lt;![A-Za-z0-9_])
        [0-9][0-9_]*(\.[0-9][0-9_]*)?
        (?:fps|ms|s|m|deg|pt|px|%)?
        (?![A-Za-z0-9_])
      </match>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>let</keyword>
      <keyword>mut</keyword>
      <keyword>sig</keyword>
      <keyword>reflect</keyword>
      <keyword>ref</keyword>
      <keyword>fn</keyword>
      <keyword>type</keyword>
      <keyword>enum</keyword>
      <keyword>import</keyword>
      <keyword>as</keyword>
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>return</keyword>
      <keyword>match</keyword>
      <keyword>case</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>repeat</keyword>
    </context>

    <context id="booleans" style-ref="boolean">
      <keyword>true</keyword>
      <keyword>false</keyword>
      <keyword>None</keyword>
    </context>

    <context id="functions" style-ref="function">
      <keyword>Fraction</keyword>
      <keyword>Color</keyword>
      <keyword>Rgb</keyword>
      <keyword>Hsv</keyword>
      <keyword>Hsl</keyword>
      <keyword>Oklab</keyword>
      <keyword>Oklch</keyword>
      <keyword>abs</keyword>
      <keyword>clamp</keyword>
      <keyword>cos</keyword>
      <keyword>frame_index</keyword>
      <keyword>lerp</keyword>
      <keyword>mouth</keyword>
      <keyword>pow</keyword>
      <keyword>random</keyword>
      <keyword>shake</keyword>
      <keyword>sin</keyword>
      <keyword>sqrt</keyword>
      <keyword>str</keyword>
      <keyword>tan</keyword>
      <keyword>timecode</keyword>
      <keyword>timecode_parts</keyword>
      <keyword>trunc</keyword>
      <keyword>vol</keyword>
    </context>

    <context id="variables" style-ref="variable">
      <keyword>canvas_height</keyword>
      <keyword>canvas_width</keyword>
      <keyword>duration</keyword>
      <keyword>fps</keyword>
      <keyword>local_t</keyword>
      <keyword>media_height</keyword>
      <keyword>media_width</keyword>
      <keyword>seed</keyword>
      <keyword>source_height</keyword>
      <keyword>source_width</keyword>
      <keyword>t</keyword>
      <keyword>time</keyword>
      <keyword>value</keyword>
      <keyword>a</keyword>
      <keyword>b</keyword>
      <keyword>g</keyword>
      <keyword>r</keyword>
      <keyword>x</keyword>
      <keyword>y</keyword>
      <keyword>z</keyword>
    </context>

    <context id="sanim">
      <include>
        <context ref="line-comment"/>
        <context ref="multiline-string"/>
        <context ref="string"/>
        <context ref="number"/>
        <context ref="booleans"/>
        <context ref="keywords"/>
        <context ref="functions"/>
        <context ref="variables"/>
      </include>
    </context>
  </definitions>
</language>
