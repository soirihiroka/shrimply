# Sibling Animation values run together; the root owns their combined extent.
mut phase = 0deg
sig size = 64pt + 16pt * sin(phase)
let disk = <Box width={size} height={size} rounded-full bg-blue3 position={[-20%,0%]} x_align={Align.Center} y_align={Align.Center}/>
let tile = <Box width={size} height={size} radius={size/6} bg-orange3 position={[20%,0%]} x_align={Align.Center} y_align={Align.Center}/>
<Animation>
    {disk}
    {tile}
    {animate(phase,to=1800deg,duration=10s,ease="linear")}
    {wait(10s)}
</Animation>
