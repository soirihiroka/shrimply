bg(Color("window_bg_dark"))
let disk = Circle(id= "disk", radius= 60pt, fill= Color("orange3"), position= Vec2(-20%, 0%))
let box = Rect(id= "box", width= 160pt, height= 100pt, fill= Color("blue3"), position= Vec2(20%, 0%))

background { Create(disk, duration=1s) }; Write(box, duration=1s)
wait(200ms)
background { Shift(disk, Vec2(0%, -15%), duration=800ms) }; RotateTo(box, 45deg, duration=800ms)
background { Uncreate(disk, duration=1s) }; Unwrite(box, duration=1s)
background { Create(disk, duration=800ms) }; Write(box, duration=800ms)
ShrinkToCenter(disk, duration=500ms)
GrowFromCenter(disk, duration=500ms)
wait(400ms)
