bg(Color("window_bg_dark"))
let disk = Circle(id= "disk", radius= 60pt, fill= Color("orange3"), position= Vec2(-20%, 0%))
let box = Rect(id= "box", width= 160pt, height= 100pt, fill= Color("blue3"), position= Vec2(20%, 0%))

background { Create(disk, duration=1s, ease="linear") }; Write(box, duration=1s, ease="linear")
wait(200ms)
background { Shift(disk, Vec2(0%, -15%), duration=800ms, ease="linear") }; RotateTo(box, 45deg, duration=800ms, ease="linear")
background { Uncreate(disk, duration=1s, ease="linear") }; Unwrite(box, duration=1s, ease="linear")
background { Create(disk, duration=800ms, ease="linear") }; Write(box, duration=800ms, ease="linear")
ShrinkToCenter(disk, duration=500ms, ease="linear")
GrowFromCenter(disk, duration=500ms, ease="linear")
wait(400ms)
