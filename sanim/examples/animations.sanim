bg(Color("window_bg_dark"))
let disk = Box(id="disk", fill=Color("orange3"), position=[-20%, 0%], width=2*(60pt), height=2*(60pt), radius="full", x_align=Align.Center, y_align=Align.Center)
let box = Box(id="box", width=160pt, height=100pt, fill=Color("blue3"), position=[20%, 0%], x_align=Align.Center, y_align=Align.Center)

Animation(children=[disk.create(duration=1s),box.write(duration=1s)])
wait(200ms)
Animation(children=[disk.shift([0%,-15%],duration=800ms),box.rotate_to(45deg,duration=800ms)])
Animation(children=[disk.uncreate(duration=1s),box.unwrite(duration=1s)])
Animation(children=[disk.create(duration=800ms),box.write(duration=800ms)])
disk.shrink_to_center(duration=500ms)
disk.grow_from_center(duration=500ms)
wait(400ms)
