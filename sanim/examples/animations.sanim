background(Color("window_bg_dark"))
let disk = Circle(id= "disk", radius= 60pt, fill= Color("orange3"), position= Vec2(-20%, 0%))
let box = Rect(id= "box", width= 160pt, height= 100pt, fill= Color("blue3"), position= Vec2(20%, 0%))

play(Create(disk), Write(box), duration= 1s)
wait(200ms)
play(Shift(disk, Vec2(0%, -15%)), RotateTo(box, 45deg), duration= 800ms)
play(Uncreate(disk), Unwrite(box), duration= 1s)
play(Create(disk), Write(box), duration= 800ms)
play(ShrinkToCenter(disk), duration= 500ms)
play(GrowFromCenter(disk), duration= 500ms)
wait(400ms)
