# Cedar Falls: a seeded, warped landscape with an inhabited clearing.
import "./voxel_structures.sanim" as structures
import "./voxel_textures.sanim" as textures
let palette = structures.materials
let seed = reflect(71, label = "Landscape Seed", key = "terrain.seed")
let relief = reflect(58, label = "Ridge Height", key = "terrain.relief")
let forest_density = reflect(0.78, label = "Forest Density", key = "terrain.forest")
let rock = VoxelMaterial(texture = textures.stone)
let water = VoxelMaterial(color = Color("white"), transmission = 1, ior = 1.333, roughness = 0.025,
    attenuation_color = Color("#43B9AD"), attenuation_distance = 15,
    wave_strength = 0.045, wave_length = 8, wave_speed = 0.55)
let falling_water = VoxelMaterial(texture = textures.waterfall, transmission = 0.55, ior = 1.333,
    roughness = 0.35, wave_strength = 0.1, wave_length = 2, wave_speed = 2)
let grass = structures.grass_material(textures.short_grass)
let flowers_white = structures.grass_material(textures.wildflower_white)
let flowers_gold = structures.grass_material(textures.wildflower_gold)

# Independent wavelengths give the land a large silhouette and smaller detail.
# Warping breaks circular contours; the river/lake carve only local low ground.
let broad = (Noise(seed = seed, axes = "xz", scale = 73, octaves = 5, persistence = 0.46)
    .warp(seed = seed + 101, axes = "xz", scale = 43, strength = 18).multiply(19).add(39))
let rear = Density(axis = "z").remap(12, 150, 1, 0).clamp(0, 1)
let ridges = (Noise(seed = seed + 17, kind = "ridged", axes = "xz", scale = 41, octaves = 3)
    .warp(seed = seed + 103, axes = "xz", scale = 33, strength = 13)
    .remap(-1, 1, 0, 1).pow(2).multiply(relief).multiply(rear))
let uplands = broad.add(ridges)
let lake = (Distance(axes = "xz").scale([1.2, 1, 0.9]).translate([145, 0, 133])
    .warp(seed = seed + 211, axes = "xz", scale = 38, strength = 16))
let lake_bed = lake.divide(49).pow(3).multiply(32).add(9)
let river = (Density(axis = "x", offset =-148)
    .add(Noise(seed = seed + 73, axes = "xz", scale = 55, octaves = 2).multiply(21)).abs())
let river_bed = river.divide(9).pow(2).multiply(25).add(17).add(rear.pow(8).multiply(120))
let natural = uplands.min(lake_bed).min(river_bed).clamp(7, 105)
# An elliptical clearing has a smooth transition into unmodified terrain.
let clearing = Distance(axes = "xz").scale([1, 1, 1.25]).translate([77, 0, 126])
let wild = clearing.smoothstep(min = 38, max = 52)
let heights = natural.multiply(wild).add(Density(value = 1).subtract(wild).multiply(32))
let ground = (VoxelGrid(size = [224, 144, 208]).heightmap(heights, rock)
    .surface(palette.sand, depth = 2, mask = Density(value = 24).subtract(Density(axis = "y")))
    .surface(palette.grass, depth = 2, mask = Density(axis = "y").subtract(23)))
let moisture = Noise(seed = seed + 53, axes = "xz", scale = 29, octaves = 3).remap(-1, 1, 0, 1)
let dry = Density(axis = "y").smoothstep(min = 21, max = 26).multiply(wild)
let meadow = moisture.smoothstep(min = 0.42, max = 0.63).multiply(dry)
let grass_density = (Noise(seed = seed + 13, axes = "xz", scale = 9).remap(-1, 1, 0, 1).pow(2)
    .multiply(0.22).multiply(dry))
mut terrain = (ground.scatter(grass, density = grass_density, seed = seed + 29)
    .scatter(flowers_white, density = meadow.multiply(0.07), seed = seed + 31)
    .scatter(flowers_gold, density = meadow.multiply(0.035), seed = seed + 37)
    .flood(level = 20, material = water))

# The spring is a reusable noise-shaped rock outcrop, with two descending pools.
let outcrop = (Density(value = 16).subtract(Distance().scale([1, 0.8, 0.85]).translate([16, 12, 15]))
    .add(Noise(seed = seed + 301, scale = 5, octaves = 3).multiply(2.2)))
mut spring = (VoxelGrid(size = [34, 35, 34]).density(outcrop, rock)
    .surface(palette.grass, depth = 1, mask = Noise(seed = seed + 303, axes = "xz", scale = 9).subtract(0.05)))
spring = (spring.erase(min = [12, 18, 11], max = [23, 35, 20])
    .carve(Density(value = 4.5).subtract(Density(axis = "x", offset =-19).abs()), min = [13, 0, 20],
        max = [25, 20, 34])
    .fill(min = [12, 18, 11], max = [23, 20, 20], material = water)
    .erase(min = [14, 10, 20], max = [23, 35, 26])
    .fill(min = [14, 10, 20], max = [23, 12, 26], material = water)
    .fill(min = [16, 12, 19], max = [21, 20, 20], material = falling_water)
    .fill(min = [17, 0, 25], max = [22, 12, 26], material = falling_water))
let outlet = Density(value = 5).subtract(Density(axis = "x", offset =-141.5).abs())
terrain = terrain.carve(outlet, min = [135, 20, 94], max = [149, 42, 110]).place(child = spring, at = [122,
        20, 70])

let cabin = <VoxelPart volume={structures.cabin()}/>
let tower = <VoxelPart volume={structures.tower()} offset={[0,0,3]}/>
let farm = <VoxelPart volume={structures.garden()} offset={[3,0,0]}/>
let homestead = <VoxelBox flow="z" gap={7} position_mode="absolute" at={[50,32,94]}>
    <VoxelBox flow="x" gap={4} align={["start","start","center"]}>
        {cabin}
        {tower}
    </VoxelBox>
    {farm}
</VoxelBox>

# Walkways, garden fencing and the lake overlook form one reusable local asset.
mut paths = VoxelGrid(size = [224, 144, 208])
paths = paths.fill(min = [67, 32, 127], max = [74, 33, 141], material = palette.cobble)
for x in [53, 84] {
    for z in range(141, 173, 5) {
        paths = paths.fill(min = [x, 32, z], max = [x + 1, 36, z + 1], material = palette.timber)
    }
    paths = paths.fill(min = [x, 34, 141], max = [x + 1, 35, 173], material = palette.timber)
}
for step in range(12) {
    let x = 88 + step * 2
    let y = 32 - step
    terrain = terrain.erase(min = [x, y + 1, 124], max = [x + 3, 42, 129])
    paths = paths.fill(min = [x, y, 124], max = [x + 3, y + 1, 129], material = palette.wood)
}
paths = paths.fill(min = [111, 20, 122], max = [138, 21, 131], material = palette.wood)
for x in [114, 134] {
    for z in [123, 129] {
        paths = paths.fill(min = [x, 12, z], max = [x + 1, 25, z + 1], material = palette.timber)
    }
}
paths = paths.fill(min = [112, 24, 122], max = [138, 25, 123], material = palette.timber)
for base in [[58, 32, 134], [86, 32, 134], [114, 21, 123], [134, 21, 129]] {
    paths = paths.fill(min = base, max = [base[0] + 1, base[1] + 5, base[2] + 1], material = palette.timber)
    paths = paths.fill(min = [base[0], base[1] + 5, base[2]], max = [base[0] + 1, base[1] + 6, base[2] + 1],
        material = palette.lantern)
}
paths = (paths.place(child = structures.barrel(), at = [80, 36, 124])
    .place(child = structures.crate(), at = [56, 36, 124]))

# Jittered, slope-aware sampling gives clustered forest rather than a tree grid.
let rng = Random(seed = seed + 209)
let oak_a = structures.tree(seed = 11)
let oak_b = structures.tree(seed = 23)
let pine_a = structures.pine(seed = 31, height = 36)
let pine_b = structures.pine(seed = 43, height = 44)
let rocks = structures.boulder(seed = 71)
mut oaks_a: List<List<Number, 3>> = []
mut oaks_b: List<List<Number, 3>> = []
mut pines_a: List<List<Number, 3>> = []
mut pines_b: List<List<Number, 3>> = []
mut stones: List<List<Number, 3>> = []
let tree_density = moisture.add(0.55).multiply(forest_density).clamp(0, 0.95)
for point in ground.surface_points(step = 10, seed = seed + 209, jitter = 0.85, density = tree_density,
    mask = wild.subtract(0.98), max_slope = 2.1) {
    let index = point[0] * 208 + point[2]
    let x = point[0]
    let y = point[1]
    let z = point[2]
    if (x > 12 and x < 202 and z > 10 and z < 186 and y > 24 and y < 88
        and ((x - 139) ** 2 + (z - 87) ** 2 > 1100)
        and (z < 90 or x < 43 or (x > 183 and z < 156))) {
        if rng.chance(index + 300000, probability = 0.15) {
            stones = append(stones, [x - 5, y - 2, z - 5])
        } else {
            let origin = [x - 9, y, z - 9]
            let variant = rng.integer(index + 400000, min = 0, max = 2)
            if z < 76 or y > 57 {
                if variant == 0 {
                    pines_a = append(pines_a, origin)
                } else {
                    pines_b = append(pines_b, origin)
                }
            } else {
                if variant == 0 {
                    oaks_a = append(oaks_a, origin)
                } else {
                    oaks_b = append(oaks_b, origin)
                }
            }
        }
    }
}
let terrain_part = <VoxelPart volume={terrain} position_mode="absolute"/>
let world = <VoxelBox size={[224,144,208]}>
    {terrain_part}
    {homestead}
    <VoxelPart volume={paths} position_mode="absolute"/>
    {Instances(asset=oak_a,positions=oaks_a,size=[224,144,208])}
    {Instances(asset=oak_b,positions=oaks_b,size=[224,144,208])}
    {Instances(asset=pine_a,positions=pines_a,size=[224,144,208])}
    {Instances(asset=pine_b,positions=pines_b,size=[224,144,208])}
    {Instances(asset=rocks,positions=stones,size=[224,144,208])}
</VoxelBox>
world.assert_disjoint(cabin, terrain_part)
world.assert_disjoint(farm, terrain_part)
world.assert_disjoint(cabin, tower)
world.assert_within(cabin, world)
world.assert_within(farm, world)

mut progress = 0
mut sun_angle = 34deg
mut lens = 53deg
sig daylight = clamp(sin(sun_angle) * 1.6, 0, 1)
sig sun = SunLight(direction = [cos(sun_angle), sin(sun_angle), 0.45], color = Color("#FFE2B8"), intensity = daylight * 1.1,
    diameter = 6deg)
sig moon = SunLight(direction = [-cos(sun_angle),-sin(sun_angle),-0.45], color = Color("#A5C8FF"), intensity = (1 - daylight) * 0.24,
    diameter = 3deg)
sig sky = Environment(top = Color("#78B3D4"), horizon = Color("#A9C9D5"), ground = Color("#4E6751"),
    intensity = 0.09 + daylight * 0.58, visible = true)
sig lamp_strength = 22 + (1 - daylight) * 150
sig porch_left = PointLight(position = [58.5, 41.5, 126.5], color = Color("#FFD195"), intensity = lamp_strength,
    radius = 1.3)
sig porch_right = PointLight(position = [78.5, 41.5, 126.5], color = Color("#FFD195"), intensity = lamp_strength,
    radius = 1.3)
sig tower_light = PointLight(position = [98, 64.5, 115], color = Color("#FFD9A2"), intensity = lamp_strength * 1.6,
    radius = 1.8)
sig pier_light = PointLight(position = [114.5, 26.5, 123.5], color = Color("#FFD195"), intensity = lamp_strength,
    radius = 1.2)
sig garden_light = PointLight(position = [58.5, 37.5, 134.5], color = Color("#FFD195"), intensity = lamp_strength,
    radius = 1.2)
let route = Curve(points = [[194, 82, 194], [179, 72, 185], [161, 62, 173], [149, 59, 161]])
let framing = Curve(points = [[111, 40, 105], [111, 40, 104], [114, 38, 105], [116, 37, 104]])
sig shot = Camera(path = route, progress = progress, target = framing.at(progress), fov = lens)
let scene = VoxelScene(layout = world, camera = shot, lights = [sun, moon, porch_left, porch_right, tower_light,
        pier_light, garden_light], environment = sky)
let travel = Curve(keys = [Keyframe(time = 0s, value = 0, handle_out = {
                time = 2s,
                value = 0.03
            }),
        Keyframe(time = 7s, value = 0.5, handle_in = {
                time =-1s,
                value =-0.1
            }, handle_out = {
                time = 1s,
                value = 0.1
            }),
        Keyframe(time = 14s, value = 1, handle_in = {
                time =-2s,
                value =-0.04
            })])
<Animation>
    {scene.fade_in(duration=500ms)}
    {animate(progress,curve=travel)}
    {animate(lens,to=57deg,duration=14s,ease="smootherstep")}
    {animate(sun_angle,to=394deg,duration=14s,ease="linear")}
</Animation>
