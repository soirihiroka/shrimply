let base_size = reflect(64pt, label="Base Size", key="shapes.size")
let amplitude = reflect(16pt, label="Pulse Amount", key="shapes.pulse")

fn<sig> pulse(sig phase: Angle, base: Length, amount: Length): sig Length {
    return base + amount * sin(phase)
}

mut phase = 0deg
let size = pulse(phase, base_size, amplitude)

let circle = <Box width={size} height={size} rounded-full fill="blue3" position={[-20%, 0%]} x_align={Align.Center} y_align={Align.Center}/>
let rectangle = <Box width={size} height={size} radius={size / 6} fill="orange3" position={[20%, 0%]} x_align={Align.Center} y_align={Align.Center}/>
Animation(children=[circle])
Animation(children=[rectangle])

let pulse_task = <Animation absolute flow="sequence">{animate(phase, to=1800deg, duration=10s, ease="linear")}</Animation>
pulse_task.join()
