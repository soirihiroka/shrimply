# Anonymous component factories share the regular Box layout and signal pipeline.
let diameter = reflect(64pt, label="Diameter")
let badge = fn (tint: Color, x: Length): Element {
    return <Box width={diameter} height={diameter} rounded-full fill={tint} position={[x, 0pt]} x_align={Align.Center} y_align={Align.Center}/>
}
let markers = [-100pt, 0pt, 100pt].map(fn (x: Length): Element {
    return badge(Color("blue3"), x)
})
for marker in markers {
    marker.fade_in(duration=150ms)
}
wait(1s)
markers.fade_out(duration=300ms)
