# One signal drives both native shapes.
fn<sig> twice(sig size: Length): sig Length {
    return size * 2
}

mut phase = 0deg
sig size = 16pt + 4pt * sin(phase)
let diameter = twice(size)

let circle = <Box width={2*(size)} height={2*(size)} rounded-full fill="light1" x_align={Align.Center} y_align={Align.Center}/>
let rect = <Box width={diameter}
    height={diameter} radius={4pt} fill="light1" x_align={Align.Center} y_align={Align.Center}/>
Animation(children=[circle])
Animation(children=[rect])

<Animation absolute flow="sequence">{animate(phase, to=720deg, duration=4s)}</Animation>
wait(4s)
