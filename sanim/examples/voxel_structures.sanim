# Shared immutable assets and pure structure factories for voxel examples.
type Materials = {
    grass: VoxelMaterial,
    stone: VoxelMaterial,
    cobble: VoxelMaterial,
    wood: VoxelMaterial,
    timber: VoxelMaterial,
    roof: VoxelMaterial,
    leaves: VoxelMaterial,
    water: VoxelMaterial,
    glass: VoxelMaterial,
    hay: VoxelMaterial,
    sand: VoxelMaterial,
    lantern: VoxelMaterial,
}

let grass = VoxelMaterial(top = read<VoxelTexture>("assets/minecraft/textures/block/grass_block_top.png"),
    side = read<VoxelTexture>("assets/minecraft/textures/block/grass_block_side.png"), bottom = read<VoxelTexture>("assets/minecraft/textures/block/dirt.png"))
let stone = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/stone_bricks.png"))
let cobble = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/cobblestone.png"))
let wood = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/oak_planks.png"))
let timber = VoxelMaterial(side = read<VoxelTexture>("assets/minecraft/textures/block/oak_log.png"),
    top = read<VoxelTexture>("assets/minecraft/textures/block/oak_log_top.png"), bottom = read<VoxelTexture>("assets/minecraft/textures/block/oak_log_top.png"))
let roof = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/dark_oak_planks.png"))
let leaves = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/oak_leaves.png"))
let water = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/water_still.png"))
let glass = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/glass.png"))
let hay = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/hay_block_side.png"))
let sand = VoxelMaterial(texture = read<VoxelTexture>("assets/minecraft/textures/block/sand.png"))
let lantern = VoxelMaterial(color = Color("#FFD68AFF"), emission = 3)

let materials: Materials = {
    grass = grass,
    stone = stone,
    cobble = cobble,
    wood = wood,
    timber = timber,
    roof = roof,
    leaves = leaves,
    water = water,
    glass = glass,
    hay = hay,
    sand = sand,
    lantern = lantern,
}

fn cabin(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [38, 38, 36])
    result = result.fill(min = [3, 0, 3], max = [35, 3, 33], material = palette.cobble)
    result = result.fill(min = [4, 3, 4], max = [34, 17, 30], material = palette.wood)
    result = result.erase(min = [6, 4, 6], max = [32, 17, 28])
    for x in [4, 31] {
        for z in [4, 27] {
            result = result.fill(min = [x, 3, z], max = [x + 3, 19, z + 3], material = palette.timber)
        }
    }
    for x in [10, 23] {
        result = result.fill(min = [x, 9, 4], max = [x + 5, 14, 6], material = palette.glass)
        result = result.fill(min = [x, 9, 28], max = [x + 5, 14, 30], material = palette.glass)
    }
    result = result.erase(min = [17, 3, 28], max = [22, 12, 30])
    result = result.fill(min = [4, 3, 30], max = [34, 4, 35], material = palette.wood)
    result = result.fill(min = [3, 4, 34], max = [17, 5, 35], material = palette.timber)
    result = result.fill(min = [22, 4, 34], max = [35, 5, 35], material = palette.timber)
    for step in range(18) {
        result = result.fill(min = [1 + step, 18 + step, 1], max = [37 - step, 19 + step, 33], material = palette.roof)
    }
    result = result.fill(min = [27, 14, 10], max = [31, 32, 14], material = palette.stone)
    result = result.fill(min = [26, 30, 9], max = [32, 31, 15], material = palette.cobble)
    for x in [8, 28] {
        result = result.fill(min = [x, 6, 32], max = [x + 1, 9, 33], material = palette.timber)
        result = result.fill(min = [x, 9, 32], max = [x + 1, 10, 33], material = palette.lantern)
    }
    return result
}

fn tower(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [12, 34, 12])
    result = result.fill(min = [1, 0, 1], max = [11, 3, 11], material = palette.cobble)
    for x in [2, 9] {
        for z in [2, 9] {
            result = result.fill(min = [x, 3, z], max = [x + 1, 27, z + 1], material = palette.timber)
        }
    }
    result = result.fill(min = [1, 23, 1], max = [11, 24, 11], material = palette.wood)
    result = result.fill(min = [0, 28, 0], max = [12, 29, 12], material = palette.roof)
    result = result.fill(min = [1, 29, 1], max = [11, 30, 11], material = palette.roof)
    result = result.fill(min = [3, 30, 3], max = [9, 31, 9], material = palette.roof)
    result = result.fill(min = [5, 31, 5], max = [7, 34, 7], material = palette.lantern)
    return result
}

fn garden(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [30, 20, 30])
    result = result.fill(min = [1, 0, 1], max = [29, 1, 29], material = palette.timber)
    result = result.fill(min = [2, 1, 2], max = [28, 2, 28], material = Color("#674630FF"))
    for x in [4, 9, 14, 19, 24] {
        result = result.fill(min = [x, 2, 3], max = [x + 2, 3, 27], material = Color("#6A9D3AFF"))
        result = result.fill(min = [x, 3, 4], max = [x + 1, 4, 26], material = palette.hay)
    }
    result = result.fill(min = [3, 2, 14], max = [27, 3, 15], material = palette.water)
    return result
}

# One local asset, suitable for Instances. The returned origin is at ground level.
# Trunk center is [7.5,0,7.5]; the immutable asset bounds are [15,27,15].
fn tree(seed: Number = 0, palette: Materials = materials): VoxelGrid {
    let crown = Density(value=6).subtract(
        Distance().scale([1,1.2,1]).translate([7.5,18,7.5])
    ).add(Noise(seed=seed,scale=3.5,octaves=3).multiply(1.4))
    let trunk = VoxelGrid(size=[15,27,15]).fill(
        min=[6,0,6], max=[9,20,9], material=palette.timber
    )
    return trunk.density(crown, palette.leaves, min=[0,10,0], max=[15,27,15])
}

fn grass_material(texture: VoxelTexture): VoxelMaterial {
    return VoxelMaterial(texture=texture,geometry="cross")
}
