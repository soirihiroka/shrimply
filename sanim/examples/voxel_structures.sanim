# Shared immutable assets and pure structure factories for voxel examples.
import "./voxel_textures.sanim" as textures
type Materials = {
    grass: VoxelMaterial,
    stone: VoxelMaterial,
    cobble: VoxelMaterial,
    wood: VoxelMaterial,
    timber: VoxelMaterial,
    roof: VoxelMaterial,
    leaves: VoxelMaterial,
    water: VoxelMaterial,
    glass: VoxelMaterial,
    hay: VoxelMaterial,
    sand: VoxelMaterial,
    lantern: VoxelMaterial,
}

let grass = VoxelMaterial(top = textures.grass_top, side = textures.grass_side, bottom = textures.dirt)
let stone = VoxelMaterial(texture = textures.stone_bricks)
let cobble = VoxelMaterial(texture = textures.cobblestone)
let wood = VoxelMaterial(texture = textures.oak_planks)
let timber = VoxelMaterial(side = textures.oak_log, top = textures.oak_log_top, bottom = textures.oak_log_top)
let roof = VoxelMaterial(texture = textures.dark_oak_planks)
let leaves = VoxelMaterial(texture = textures.oak_leaves)
let water = VoxelMaterial(texture = textures.water)
let glass = VoxelMaterial(texture = textures.glass)
let hay = VoxelMaterial(texture = textures.hay)
let sand = VoxelMaterial(texture = textures.sand)
let lantern = VoxelMaterial(color = Color("#FFD68AFF"), emission = 3)

let materials: Materials = {
    grass = grass,
    stone = stone,
    cobble = cobble,
    wood = wood,
    timber = timber,
    roof = roof,
    leaves = leaves,
    water = water,
    glass = glass,
    hay = hay,
    sand = sand,
    lantern = lantern,
}

fn cabin(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [38, 38, 36])
    result = result.fill(min = [3, 0, 3], max = [35, 3, 33], material = palette.cobble)
    result = result.fill(min = [4, 3, 4], max = [34, 17, 30], material = palette.wood)
    result = result.erase(min = [6, 4, 6], max = [32, 17, 28])
    for x in [4, 31] {
        for z in [4, 27] {
            result = result.fill(min = [x, 3, z], max = [x + 3, 19, z + 3], material = palette.timber)
        }
    }
    for x in [10, 23] {
        result = result.fill(min = [x, 9, 4], max = [x + 5, 14, 6], material = palette.glass)
        result = result.fill(min = [x, 9, 28], max = [x + 5, 14, 30], material = palette.glass)
    }
    result = result.erase(min = [17, 3, 28], max = [22, 12, 30])
    result = result.fill(min = [4, 3, 30], max = [34, 4, 35], material = palette.wood)
    result = result.fill(min = [3, 4, 34], max = [17, 5, 35], material = palette.timber)
    result = result.fill(min = [22, 4, 34], max = [35, 5, 35], material = palette.timber)
    for step in range(18) {
        result = result.fill(min = [1 + step, 18 + step, 1], max = [37 - step, 19 + step, 33], material = palette.roof)
    }
    result = result.fill(min = [27, 14, 10], max = [31, 32, 14], material = palette.stone)
    result = result.fill(min = [26, 30, 9], max = [32, 31, 15], material = palette.cobble)
    for x in [8, 28] {
        result = result.fill(min = [x, 6, 32], max = [x + 1, 9, 33], material = palette.timber)
        result = result.fill(min = [x, 9, 32], max = [x + 1, 10, 33], material = palette.lantern)
    }
    return result
}

fn tower(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [12, 34, 12])
    result = result.fill(min = [1, 0, 1], max = [11, 3, 11], material = palette.cobble)
    for x in [2, 9] {
        for z in [2, 9] {
            result = result.fill(min = [x, 3, z], max = [x + 1, 27, z + 1], material = palette.timber)
        }
    }
    result = result.fill(min = [1, 23, 1], max = [11, 24, 11], material = palette.wood)
    result = result.fill(min = [0, 28, 0], max = [12, 29, 12], material = palette.roof)
    result = result.fill(min = [1, 29, 1], max = [11, 30, 11], material = palette.roof)
    result = result.fill(min = [3, 30, 3], max = [9, 31, 9], material = palette.roof)
    result = result.fill(min = [5, 31, 5], max = [7, 34, 7], material = palette.lantern)
    return result
}

fn garden(palette: Materials = materials): VoxelGrid {
    mut result = VoxelGrid(size = [30, 20, 30])
    result = result.fill(min = [1, 0, 1], max = [29, 1, 29], material = palette.timber)
    result = result.fill(min = [2, 1, 2], max = [28, 2, 28], material = Color("#674630FF"))
    for x in [4, 9, 14, 19, 24] {
        result = result.fill(min = [x, 2, 3], max = [x + 2, 3, 27], material = Color("#6A9D3AFF"))
        result = result.fill(min = [x, 3, 4], max = [x + 1, 4, 26], material = palette.hay)
    }
    result = result.fill(min = [3, 2, 14], max = [27, 3, 15], material = palette.water)
    return result
}

# Branching deciduous crowns share one immutable asset per seed.
# The trunk center is [9,0,9]; the asset bounds are [19,31,19].
fn tree(seed: Number = 0, palette: Materials = materials): VoxelGrid {
    let first = Density(value = 5.5).subtract(Distance(center = [6.5, 20, 8]))
    let second = Density(value = 5.6).subtract(Distance(center = [12, 22, 10]))
    let third = Density(value = 5.2).subtract(Distance(center = [8, 18, 13]))
    let crown = first.max(second).max(third).add(Noise(seed = seed, scale = 3, octaves = 3).multiply(1.3))
    mut result = VoxelGrid(size = [19, 31, 19]).fill(min = [8, 0, 8], max = [10, 19, 10], material = palette.timber)
    for step in range(5) {
        result = result.fill(min = [9 + step, 12 + step, 9], max = [11 + step, 14 + step, 11], material = palette.timber)
        result = result.fill(min = [8 - step, 11 + step, 9], max = [10 - step, 13 + step, 11], material = palette.timber)
    }
    return result.density(crown, palette.leaves, min = [0, 11, 0], max = [19, 30, 19])
}

let needles = VoxelMaterial(texture = textures.spruce_leaves)
let rubble = VoxelMaterial(texture = textures.stone)

# Overlapping conical branch whorls, rather than a scaled copy of the oak crown.
fn pine(seed: Number = 0, height: Number = 40, palette: Materials = materials): VoxelGrid {
    let stride = (height - 8) / 6
    mut result = VoxelGrid(size = [19, 48, 19]).fill(min = [8, 0, 8], max = [10, height - 3, 10], material = palette.timber)
    for layer in range(6) {
        let bottom = 8 + floor(layer * stride)
        let radius = 8.2 - layer * 1.12
        let taper = Density(axis = "y", offset =-bottom).multiply(radius / (stride * 1.5))
        let crown = (Density(value = radius).subtract(Distance(center = [9, 0, 9], axes = "xz"))
            .subtract(taper).add(Noise(seed = seed + layer, scale = 2.5, octaves = 2).multiply(0.75)))
        result = result.density(crown, needles, min = [0, bottom, 0], max = [19, min(ceil(bottom + stride * 1.5),
                    height), 19])
    }
    return result
}

fn boulder(seed: Number = 0, palette: Materials = materials): VoxelGrid {
    let shape = (Density(value = 4.7).subtract(Distance().scale([1, 0.62, 0.85]).translate([5.5, 3, 5.5]))
        .add(Noise(seed = seed, scale = 3, octaves = 3).multiply(0.8)))
    return (VoxelGrid(size = [11, 8, 11]).density(shape, rubble)
        .surface(palette.grass, depth = 1, mask = Noise(seed = seed + 91, scale = 6, axes = "xz").subtract(0.05)))
}

fn grass_material(texture: Texture): VoxelMaterial {
    return VoxelMaterial(texture = texture, geometry = "cross")
}

fn barrel(palette: Materials = materials): VoxelGrid {
    let distance = Distance(center = [2, 0, 2], axes = "xz")
    let body = Density(value = 1.9).subtract(distance)
    let rim = body.min(distance.subtract(1))
    let iron = VoxelMaterial(color = Color("#5D6765"), roughness = 0.5)
    mut result = VoxelGrid(size = [4, 6, 4]).density(body, palette.timber, min = [0, 0, 0], max = [4,
            5, 4])
    for y in [1, 4] {
        result = result.density(rim, iron, min = [0, y, 0], max = [4, y + 1, 4])
    }
    return result
}

fn crate(palette: Materials = materials): VoxelGrid {
    return (VoxelGrid(size = [6, 5, 4]).fill(min = [0, 0, 0], max = [6, 4, 4], material = palette.wood)
        .erase(min = [1, 1, 1], max = [5, 5, 3])
        .fill(min = [1, 1, 1], max = [5, 3, 3], material = palette.hay)
        .fill(min = [0, 0, 0], max = [1, 4, 4], material = palette.timber)
        .fill(min = [5, 0, 0], max = [6, 4, 4], material = palette.timber))
}
