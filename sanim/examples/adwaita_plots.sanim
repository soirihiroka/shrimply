# Native XML-style elements, shared scales, and Adwaita colors.
fn Panel(caption: String, position: List<Percent,2>, xs: LinearScale, ys: LinearScale, plots: List<Element>): Element {
    return <Box w-400 h-220 position={position} x_align={Align.Center} y_align={Align.Center}>
        <Grid absolute scale={xs} ticks={[-3,-2,-1,0,1,2,3]} spans={[[-45pt, 45pt]]}
            fill="light5" grid_opacity={0.12} highlight={[0]} />
        <Axis absolute scale={xs} ticks={[-3,-2,-1,0,1,2,3]} position={[0pt, 60pt]}
            font_size={10pt} label_gap={3pt} tick_length={4pt} fill="light4" />
        <Axis absolute scale={ys} tick_count={5} vertical position={[-174pt, 0pt]}
            font_size={10pt} label_gap={3pt} tick_length={4pt} format=".1f" fill="light4" />
        <Label absolute position={[0pt, -78pt]} font_size={18pt} fill="light1">{caption}</Label>
        <Box absolute w-full h-full x_align={Align.Center} y_align={Align.Center} children={plots} />
    </Box>
}

let xs = LinearScale(domain=[-3.5, 3.5],range=[-160pt, 160pt])
let waves_y = LinearScale(domain=[-1.2, 1.2],range=[45pt, -45pt])
let density_y = LinearScale(domain=[0, 0.65],range=[45pt, -45pt])
let probability_y = LinearScale(domain=[0, 1],range=[45pt, -45pt])
let samples = [-2.7,-2.1,-1.8,-1.5,-1.2,-1.0,-0.8,-0.6,-0.4,-0.3,-0.2,0,0.1,0.2,0.4,0.7,0.9,1.1,1.4,1.8,2.3,2.7]
let wave = [{x=-3,y=-0.1},{x=-2,y=-0.9},{x=-1,y=-0.75},{x=0,y=0},{x=1,y=0.75},{x=2,y=0.9},{x=3,y=0.1}]
let confidence = [{x=-3,low=-0.3,high=0.1},{x=-2,low=-1.1,high=-0.7},{x=-1,low=-0.95,high=-0.55},{x=0,low=-0.2,high=0.2},{x=1,low=0.55,high=0.95},{x=2,low=0.7,high=1.1},{x=3,low=-0.1,high=0.3}]

let curve = <LinePlot absolute data={wave} x_scale={xs} y_scale={waves_y}
    interpolation="monotone" fill="blue3" width={2.5pt} />
let interval = <BandPlot absolute data={confidence} x_scale={xs} y_scale={waves_y} fill="blue3" />
let histogram = <Histogram absolute values={samples} bins={14} normalization="density"
    x_scale={xs} y_scale={density_y} fill="blue3" opacity={0.60} />
let estimated = <DensityPlot absolute values={samples} bandwidth={0.55}
    x_scale={xs} y_scale={density_y} fill="orange3" shade={false} />
let empirical = <ECDFPlot absolute values={samples} x_scale={xs} y_scale={probability_y} fill="green3" />
let normal = <NormalCurve absolute x_scale={xs} y_scale={density_y} fill="blue3" std_dev={0.7} shade />
let wide = <NormalCurve absolute x_scale={xs} y_scale={density_y} fill="purple3" std_dev={1.3} shade />
let shifted = <NormalCurve absolute x_scale={xs} y_scale={density_y} fill="orange3" mean={1.1}
    std_dev={0.8} shade={false} />

let top_left = <Panel caption="Shape-preserving curves & bands" position={[-24%, -12%]}
    xs={xs} ys={waves_y} plots={[interval,curve]} />
let top_right = <Panel caption="Histogram & Gaussian density" position={[24%, -12%]}
    xs={xs} ys={density_y} plots={[histogram,estimated,
        <Legend absolute labels={["Density histogram","Gaussian KDE"]} colors={[Color("blue3"),Color("orange3")]}
            position={[-110pt, 86pt]} font_size={10pt} gap={14pt} swatch_width={12pt} />
    ]} />
let bottom_left = <Panel caption="Empirical cumulative distribution" position={[-24%, 28%]}
    xs={xs} ys={probability_y} plots={[empirical]} />
let bottom_right = <Panel caption="Normal distribution families" position={[24%, 28%]}
    xs={xs} ys={density_y} plots={[normal,wide,shifted,
        <Legend absolute labels={["σ=0.7","σ=1.3","μ=1.1"]} colors={[Color("blue3"),Color("purple3"),Color("orange3")]}
            position={[-108pt, 86pt]} font_size={10pt} gap={14pt} swatch_width={12pt} />
    ]} />
let title = <Label position={[0%, -44%]} font_size={27pt} fill="light1">Native plots. Adwaita colors.</Label>
let subtitle = <Label position={[0%, -36%]} font_size={13pt} fill="light4">Typed data • shared scales • bounded statistics • cached vector paths</Label>

[title,subtitle].fade_in(duration=300ms)
[top_left,top_right,bottom_left,bottom_right].create(duration=1s, ease="smooth")
wait(2s)
[top_left,top_right,bottom_left,bottom_right,title,subtitle].fade_out(duration=400ms)
