# Gradient utilities share native LinearGradient paints and the Adwaita palette.
let examples = <Box flex flex-row flex-wrap gap-24 justify-center items-center x_align={Align.Center} y_align={Align.Center}>
    <Box w-220 h-120 rounded-xl bg-linear-to-r from-blue3 to-purple3 flex flex-col items-center justify-center>
        <Label font_size={18pt}>Two colors</Label>
    </Box>
    <Box w-220 h-120 rounded-xl bg-linear-to-br from-purple3 via-blue3 via-30% to-green3 flex flex-col items-center justify-center>
        <Label font_size={18pt}>Positioned middle stop</Label>
    </Box>
    <Box w-220 h-120 rounded-xl bg-linear-to-r from-orange3 flex flex-col items-center justify-center>
        <Label font_size={18pt}>Fade to transparent</Label>
    </Box>
</Box>
examples.fade_in()
wait(2s)
