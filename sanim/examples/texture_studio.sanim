# The same immutable Texture values work in Image and VoxelMaterial.
# This entire image is generated by Sanim; no input files or runtime writes.
let seed = reflect(42, label = "Pattern Seed", key = "textures.seed")
let grain = (Noise(seed = seed, axes = "xy", scale = 28, octaves = 5)
    .warp(seed = seed + 11, axes = "xy", scale = 31, strength = 17).remap(-1, 1, 0, 1))
let stone = Texture(size = [384, 192], field = grain,
    colors = [Oklch(0.28, 0.045, 245deg), Oklch(0.68, 0.065, 120deg), Oklch(0.91, 0.035, 85deg)])
let veins = (Density(axis = "x").multiply(0.09).add(grain.multiply(12))
    .sin().remap(-1, 1, 0, 1).smoothstep(min = 0.25, max = 0.8))
let marble = Texture(size = [384, 192], field = veins,
    colors = [Oklch(0.31, 0.055, 235deg), Oklch(0.76, 0.06, 195deg), Oklch(0.96, 0.012, 120deg)])
let checks = Density(axis = "x").divide(16).floor().add(Density(axis = "y").divide(16).floor()).mod(2)
let checker = Texture(size = [384, 192], field = checks, colors = [Color("#33383E"), Color("#454C54")])
let feather = Density(value = 1).subtract(Distance(center = [80, 80, 0], axes = "xy").divide(76)).smoothstep(min = 0,
    max = 0.35)
let badge = (Texture(size = [160, 160], field = Density(axis = "x").divide(160), alpha = feather,
        colors = [Oklch(0.74, 0.14, 45deg), Oklch(0.74, 0.14, 320deg)])
    .draw(<Label font_size={15pt} fill="light1">NATIVE</Label>))
let composite = checker.composite(badge.rotate(18deg, filter = "triangle"), at = [100, 2])
let edited = (stone.crop(min = [32, 20], size = [256, 128]).resize(size = [384, 192], filter = "lanczos3")
    .hue(65deg).contrast(factor = 1.18).saturation(factor = 1.3))

fn Card(title: String, detail: String, texture: Texture, position: List<Percent, 2>): Element {
    return <Box w-540 h-330 position={position} x_align={Align.Center} y_align={Align.Center}>
        <Image absolute src={texture} width={350pt} height={175pt}/>
        <Label absolute position={[0pt,-115pt]} font_size={19pt} fill="light1">{title}</Label>
        <Label absolute position={[0pt,115pt]} font_size={12pt} fill="light4">{detail}</Label>
    </Box>
}
let title = <Label position={[0%,-45%]} font_size={29pt} fill="light1">Texture studio</Label>
let subtitle = <Label position={[0%,-38%]} font_size={13pt} fill="light4">Seeded fields · perceptual color · immutable image operations</Label>
let first = <Card title="Warped fractal noise" detail="Independent seed, scale and octaves" texture={stone} position={[-25%,-13%]}/>
let second = <Card title="Procedural marble" detail="Reusable fields + OKLCH color ramps" texture={marble} position={[25%,-13%]}/>
let third = <Card title="Alpha + transforms" detail="Feathered mask, rotation, source-over composition" texture={composite} position={[-25%,26%]}/>
let fourth = <Card title="Pillow-style editing" detail="Crop · Lanczos resize · hue · contrast · saturation" texture={edited} position={[25%,26%]}/>;
[title, subtitle, first, second, third, fourth].fade_in(duration = 400ms)
wait(3s)
