bg(#121826)
type DotStyle = {
    fill: Color,
    radius: Length,
}

let dot_style: DotStyle = reflect({
    fill= Color("orange"),
    radius= 24pt,
})
let repetitions: Number = reflect(2)

fn make_dot(identity: String, appearance: DotStyle): Element {
    return Circle(
        id= identity,
        radius= appearance.radius,
        fill= appearance.fill,
        position= Vec2(-30%, 0%),
    )
}

let marker = make_dot("marker", dot_style)
FadeIn(marker, duration=250ms, ease="linear")
repeat repetitions {
    MoveTo(marker, Vec2(30%, 0%), duration=750ms, ease="smooth")
    MoveTo(marker, Vec2(-30%, 0%), duration=750ms, ease="smooth")
}
assert(always(inside_canvas(marker)))
wait(500ms)
