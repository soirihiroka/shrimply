bg(Color("#121826"))
type DotStyle = {
    fill: Color,
    radius: Length,
}

let dot_style: DotStyle = reflect({
    fill= Color("orange"),
    radius= 24pt,
})
let repetitions: Number = reflect(2)

fn make_dot(identity: String, appearance: DotStyle): Element {
    return Box(id=identity, fill=appearance.fill, position=[-30%, 0%], width=2*(appearance.radius), height=2*(appearance.radius), radius="full", x_align=Align.Center, y_align=Align.Center)
}

let marker = make_dot("marker", dot_style)
marker.fade_in(duration=250ms)
repeat repetitions {
    marker.move_to([30%, 0%], duration=750ms, ease="smooth")
    marker.move_to([-30%, 0%], duration=750ms, ease="smooth")
}
assert(always(inside_canvas(marker)))
wait(500ms)
