background(#121826)
type Sample = { id: String, rank: Number, value: Number }
let settings = read<Dict>("query.yaml")
let samples = read<Table<Sample>>("samples.csv")
reflect tint: Color = decode<Color>(settings["appearance"]["fill"])

let rows = query(
    "SELECT id, rank, value FROM samples WHERE value >= :minimum ORDER BY rank",
    tables= {samples= samples},
    params= {"minimum": decode<Number>(settings["minimum"])},
)

for row in rows {
    let identity = decode<String>(row["id"])
    let rank = decode<Number>(row["rank"])
    let amount = decode<Number>(row["value"])
    let bar = Rect(
        id= identity,
        width= amount * 1pt,
        height= 32pt,
        fill= tint,
        position= Vec2(0%, (rank * 20 - 30) * 1%),
    )
    play(FadeIn(bar), duration= 200ms)
    assert(always(inside_canvas(bar)))
}
wait(1s)
