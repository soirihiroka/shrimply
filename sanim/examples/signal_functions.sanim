# Live parameters and escaping signal returns share one retained animation DAG.
fn<sig> twice(sig value: Length): sig Length {
    return value * 2
}

let base_size = reflect(32pt, label="Base Size", key="shapes.size")
mut phase = 0deg
sig radius = base_size + 8pt * sin(phase)
let diameter = twice(radius)

let circle = <Box width={diameter} height={diameter} rounded-full fill="blue3" position={[-20%, 0%]} x_align={Align.Center} y_align={Align.Center}/>
let rectangle = <Box width={diameter} height={diameter} radius={diameter / 6} fill="orange3" position={[20%, 0%]} x_align={Align.Center} y_align={Align.Center}/>
Animation(children=[circle])
Animation(children=[rectangle])

animate(phase,to=1800deg,duration=10s,ease="linear")
