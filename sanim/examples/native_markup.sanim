# Native element notation, GNOME-style presets, relative sizing and a Skia shader.
let heading=<Label font_size={28pt} position={[0%, -37%]}>Native by design.</Label>
let subtitle=<Label font_size={14pt} fill="light4" position={[0%, -27%]}>Typed elements · Adwaita palette · shared Taffy layout</Label>
let card=<Box w-62% h-38% rounded-xl bg-card_bg_dark border border-dark2 flex flex-col items-center justify-center gap-16 p-20 x_align={Align.Center} y_align={Align.Center}>
    <Label font_size={24pt}>A small, native component.</Label>
    <Box w-220 h-48 pill fill={LinearGradient(from=Color("blue3"),to=Color("purple3"))} x_align={Align.Center} y_align={Align.Center}>
        <Label font_size={16pt}>A real Skia gradient</Label>
    </Box>
</Box>
let suggested=<Box position={[-17%, 33%]} w-180 h-42 pill suggested x_align={Align.Center} y_align={Align.Center}><Label font_size={14pt}>Suggested action</Label></Box>
let destructive=<Box position={[17%, 33%]} w-180 h-42 pill destructive x_align={Align.Center} y_align={Align.Center}><Label font_size={14pt}>Destructive action</Label></Box>
[heading,subtitle].fade_in(duration=300ms)
card.fade_in(duration=400ms)
[suggested,destructive].fade_in(duration=300ms)
wait(2s)
[heading,subtitle,card,suggested,destructive].fade_out(duration=400ms)
