# Native element notation, GNOME-style presets, relative sizing and a Skia shader.
let heading=<Label font_size={28pt} position={Vec2(0%,-37%)}>Native by design.</Label>
let subtitle=<Label font_size={14pt} fill="light4" position={Vec2(0%,-27%)}>Typed elements · Adwaita palette · shared Taffy layout</Label>
let card=<Rect design="w-62% h-38% rounded-xl bg-card_bg_dark border border-dark2 col items-center justify-center gap-16 p-20">
    <Label font_size={24pt}>A small, native component.</Label>
    <Rect design="w-220 h-48 pill" fill={LinearGradient(from=Color("blue3"),to=Color("purple3"))}>
        <Label font_size={16pt}>A real Skia gradient</Label>
    </Rect>
</Rect>
let suggested=<Rect position={Vec2(-17%,33%)} design="w-180 h-42 pill suggested"><Label font_size={14pt}>Suggested action</Label></Rect>
let destructive=<Rect position={Vec2(17%,33%)} design="w-180 h-42 pill destructive"><Label font_size={14pt}>Destructive action</Label></Rect>
FadeIn([heading,subtitle],duration=300ms)
FadeIn(card,duration=400ms)
FadeIn([suggested,destructive],duration=300ms)
wait(2s)
FadeOut([heading,subtitle,card,suggested,destructive],duration=400ms)
